; Engine configuration file.
; CHRONOLITH — vertical slice prototype (GDD §14)

config_version=5

[application]

config/name="CHRONOLITH"
config/description="A dying alien's mind inside a NASA rover defends a time-bending crystal against an invading armada."
run/main_scene="res://scenes/v1/entry.tscn"
config/features=PackedStringArray("4.7")
config/icon="res://icon.svg"

[audio]

buses/default_bus_layout=""

[autoload]

Bus="*res://core/event_bus.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="gl_compatibility"
# The ground grid must hold at glancing camera angles (the player camera is
# nearly horizontal): without anisotropic filtering the 1 m grid minifies
# away on flat ground while it survives on steeper ground — the texture
# appears to "live" on a different face of the ground than the one you are
# driving on (playtest fix 5)
textures/default_filters/anisotropic_filtering_level=16

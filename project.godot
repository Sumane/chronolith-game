; Engine configuration file.
; CHRONOLITH — vertical slice prototype (GDD §14)

config_version=5

[application]

config/name="CHRONOLITH"
config/description="A dying alien's mind inside a NASA rover defends a time-bending crystal against an invading armada."
run/main_scene="res://core/main.tscn"
config/features=PackedStringArray("4.7")
config/icon="res://icon.svg"

[audio]

buses/default_bus_layout=""

[autoload]

Bus="*res://core/event_bus.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="gl_compatibility"
